# build output; build/docker/ is source (the devcontainer, handbook
# devcontainer.md §1) and `make clean` keeps it
/build/*
!/build/docker/
*/**/build/
*.o
*.d
!changelog.d/
*.elf
*.hex
*.bin
*.map
*.lst
*.su

# coverage
*.gcno
*.gcda
*.gcov
coverage/
coverage.out
lcov.info

# go
sdk/go/bin/

# python
__pycache__/
*.pyc

# editors / os
*.swp
*~
.DS_Store
