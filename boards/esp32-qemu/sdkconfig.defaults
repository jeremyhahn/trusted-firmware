# SPDX-License-Identifier: commercial
#
# Espressif's QEMU: the OpenCores Ethernet MAC it emulates, and the 4 MB of
# flash it is given. Flash encryption stays off here: the emulator's eFuses
# are a file the test writes, and the test's subject is secure boot and the
# identity, not the encryption ESP-IDF performs. The P4 board turns it on.
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_OPENETH=y
CONFIG_ETH_USE_ESP32_EMAC=n
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
