# The public half of the releasability gate's pattern list: generic shapes of a
# leak that hold for any checkout, so the gate means something wherever it runs.
# Format: class <TAB> extended regex (case-insensitive) <TAB> waiver.
#
# The values that name a particular private fleet -- its subnets, hostnames,
# home paths and account names -- are not written in this tree. They live in a
# private pattern file of the same format, which scripts/releasability.sh reads
# beside this one: $RELEASABILITY_PRIVATE_PATTERNS, else
# ${XDG_CONFIG_HOME:-$HOME/.config}/trusted-firmware/releasability.patterns
# (docs/development/releasability.md).
#
# Every line carries an inline waiver, because this file is published and
# scanned like any other.
#
lab-host	[A-Za-z0-9-]\.(internal|lan|home\.arpa)($|[^A-Za-z0-9-])	# lab-string-ok: a private-network DNS name (ICANN .internal, RFC 8375 home.arpa, the de facto .lan)
owner-path	/(home|Users)/[A-Za-z0-9_][A-Za-z0-9_.-]*/	# lab-string-ok: a path under someone's home directory: a workstation path
owner-path	\.agent-identity	# lab-string-ok: an agent's local identity and key directory
